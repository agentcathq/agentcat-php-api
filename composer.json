{
    "name": "agentcat/api",
    "description": "Generated PHP client for the AgentCat API, consumed by agentcat/sdk.",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "analytics",
        "agentcat",
        "ai",
        "llm"
    ],
    "homepage": "https://agentcat.com",
    "license": "MIT",
    "authors": [
        {
            "name": "AgentCat, Inc.",
            "email": "support@agentcat.com",
            "homepage": "https://agentcat.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "AgentCat\\Api\\": "src/"
        }
    },
    "type": "library",
    "support": {
        "issues": "https://github.com/agentcathq/agentcat-php-api/issues",
        "source": "https://github.com/agentcathq/agentcat-php-api",
        "docs": "https://docs.agentcat.com"
    }
}
