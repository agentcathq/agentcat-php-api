{
    "name": "agentcat/api",
    "description": "Typed request models for the AgentCat public API, generated from its OpenAPI schema and consumed by agentcat/sdk.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "AgentCat\\Api\\": "src/"
        }
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "analytics",
        "agentcat",
        "ai",
        "llm"
    ],
    "homepage": "https://agentcat.com",
    "authors": [
        {
            "name": "AgentCat, Inc.",
            "email": "support@agentcat.com",
            "homepage": "https://agentcat.com"
        }
    ],
    "support": {
        "issues": "https://github.com/agentcathq/agentcat-php-api/issues",
        "source": "https://github.com/agentcathq/agentcat-php-api",
        "docs": "https://docs.agentcat.com"
    }
}
